# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL from docker-compose.yml (host port 5434).
DATABASE_URL=postgres://argent:argent@localhost:5434/argent
# Used by the API test suite; the database name must end in _test (it is truncated between tests).
TEST_DATABASE_URL=postgres://argent:argent@localhost:5434/argent_test

# HS256 signing secret for access tokens: at least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes

# Web and API must share the same registrable domain (PRD 01a NFR-11).
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Base URL used to build links in emails; never derived from the request Host header.
WEB_BASE_URL=http://localhost:3000

# console | mailpit | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=

# hibp | fake
BREACH_CHECKER=hibp

# Number of reverse proxies in front of the API whose X-Forwarded-* headers are trusted (0 = none).
TRUST_PROXY=0

# Dedicated database for Playwright e2e (name must end in _e2e)
E2E_DATABASE_URL=postgres://argent:argent@localhost:5434/argent_e2e

# Production (NODE_ENV=production) requires: EMAIL_PROVIDER=resend, BREACH_CHECKER=hibp,
# https:// WEB_ORIGIN / API_ORIGIN / WEB_BASE_URL, TRUST_PROXY>=1, and a real JWT_SECRET
# (values starting with change-me are rejected).
